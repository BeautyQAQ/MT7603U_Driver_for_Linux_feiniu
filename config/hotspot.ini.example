# 修改后运行 sudo ./restart.sh 生效；不要在值后追加行内注释。
[wifi]
ssid = FN-NAS-Test
password = ChangeThisPassword
channel = 6

[network]
# 有线出口；热点子网不得与现有局域网/VPN/Docker 子网冲突。
uplink = enp1s0
address = 192.168.77.1/24
dhcp_start = 192.168.77.100
dhcp_end = 192.168.77.120
dns = 192.168.4.1
# true: 仅热点流量跳过 Mihomo 重定向，通过有线口直接共享网络。
bypass_mihomo = true
