# 修改后运行 sudo ./restart.sh 生效；不要在值后追加行内注释。
[wifi]
# true：热点运行时从飞牛网络设置隐藏无线网卡；修改后需重启热点。
# 缺省为 false，保持原有网络路径；名称、密码和 DHCP 配置不受影响。
hide_from_nas = false
ssid = FN-NAS-Test
password = ChangeThisPassword
channel = 6

[network]
# 有线出口；热点子网不得与现有局域网/VPN/Docker 子网冲突。
uplink = enp1s0
address = 192.168.77.1/24
dhcp_start = 192.168.77.100
dhcp_end = 192.168.77.120
# 使用直连时也可访问的真实 DNS；热点网关不提供 DNS。
# Mihomo 运行时可启用 any:53 和 tcp://any:53 劫持，停止后直接查询此服务器。
dns = 223.5.5.5,119.29.29.29
# false: 普通网关，允许 Mihomo 接管分流，停止后允许直连；true: 主动绕过 Mihomo。
bypass_mihomo = false
mihomo_tun = Meta
mihomo_table = 2022
